node_modules/
.env
*.local

# Database (inkl. eventuelle backup-kopier, f.eks. "familiehub.db.backup-2026-08-08")
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.db.*
backend/data/*.db-*.*
fleet/backend/data/*.db
fleet/backend/data/*.db-journal
fleet/backend/data/*.db-wal
fleet/backend/data/*.db-shm
butikkhub/backend/data/*.db
butikkhub/backend/data/*.db-journal
butikkhub/backend/data/*.db-wal
butikkhub/backend/data/*.db-shm

# Bilder til fotoramme (lokalt innhold, ikke del av repo)
photos/*
!photos/.gitkeep

# Opplastede belønningsbilder (lokalt innhold, ikke del av repo)
backend/data/reward-images/

# Lokalt TLS-sertifikat for https-tilgang på hjemmenettverket (maskinspesifikt,
# genereres med certs/generate.sh – se certs/README.md)
certs/*.pem
certs/*.cnf

# Build
frontend/dist/
backend/dist/
fleet/frontend/dist/
butikkhub/frontend/dist/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
