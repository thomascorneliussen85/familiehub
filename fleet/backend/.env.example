# ====== FamilieHub Fleet – miljøvariabler ======
# Kopier til ".env" og fyll inn egne verdier. ".env" skal ALDRI committes.

PORT=4100
NODE_ENV=development
CORS_ORIGIN=http://localhost:5180,https://localhost:5180

DB_PATH=./data/fleet.db

# MÅ settes til en ekte, tilfeldig verdi før produksjon: openssl rand -hex 32
JWT_SECRET=

# ---- Admin-innlogging til dashbordet (kun én bruker i v1) ----
FLEET_ADMIN_USERNAME=admin
# Generer med: node src/scripts/hashPassword.mjs <ditt-passord>
FLEET_ADMIN_PASSWORD_HASH=

# ---- Hub-registrering ----
# Delt hemmelighet brukt av oppsettskommandoen på en NY hub for å registrere
# seg selv (adskilt fra admin-innloggingen over). Generer f.eks. med:
# openssl rand -hex 24
FLEET_SETUP_TOKEN=
