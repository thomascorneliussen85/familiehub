# ====== ButikkHub – miljøvariabler ======
# Kopier til ".env" og fyll inn egne verdier. ".env" skal ALDRI committes.

PORT=4200
NODE_ENV=development
CORS_ORIGIN=http://localhost:5190,https://localhost:5190

DB_PATH=./data/butikkhub.db

# MÅ settes til en ekte, tilfeldig verdi før produksjon: openssl rand -hex 32
JWT_SECRET=
