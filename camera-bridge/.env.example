# URL-en til FamilieHub-skytjenesten din (uten sti/skråstrek på slutten)
FAMILIEHUB_URL=https://familiehub-1.onrender.com

# Generert i FamilieHub -> Innstillinger -> Enheter -> "Generer bro-nøkkel"
BRIDGE_ID=
BRIDGE_API_KEY=

# Brukernavn/passord satt opp under "Tredjepartskompatibilitet" (ONVIF) i
# Tapo-appen. Samme brukernavn/passord brukes vanligvis for alle kameraene
# dine hvis du setter dem opp likt.
TAPO_USERNAME=
TAPO_PASSWORD=

# Sti til ffmpeg – la stå som "ffmpeg" hvis det er installert globalt
# (installer med: sudo apt install ffmpeg)
FFMPEG_PATH=ffmpeg

# Hvor ofte broen leter etter nye kameraer på nettverket (millisekunder)
DISCOVERY_INTERVAL_MS=30000
