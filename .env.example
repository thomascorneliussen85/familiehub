# ====== FamilieHub – miljøvariabler ======
# Kopier denne filen til ".env" og fyll inn dine egne verdier.
# ".env" skal ALDRI committes til git (den ligger i .gitignore).

# ---- Server ----
PORT=4000
NODE_ENV=development
# Origin(er) frontend kjører på (kommaseparert), brukes til CORS. Legg til
# https-adressen på hjemmenettverket (se certs/README.md) for at nettbrett
# skal kunne bruke talegjenkjenning, som krever en sikker tilkobling.
CORS_ORIGIN=http://localhost:5173,https://localhost:5173

# ---- Database ----
# Sti til SQLite-databasefilen (relativt til backend/)
DB_PATH=./data/familiehub.db

# ---- Innlogging (flerfamilie-støtte) ----
# MÅ settes til en ekte, tilfeldig verdi før dette hostes for flere familier
# (signerer innloggingsøkter – med standardverdien kan hvem som helst
# forfalske en økt). Generer f.eks. med: openssl rand -hex 32
JWT_SECRET=
# Kun nødvendig ÉN gang, ved migrering av en database som fantes FØR
# flerfamilie-støtten – knytter eksisterende data til en ny innlogging.
# Ikke nødvendig ved en helt fersk installasjon (signup i appen holder).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FAMILY_NAME=Vår familie

# ---- Google Calendar-tilkobling (per familiemedlem, kobles til fra ⚙️ → Kalendere) ----
# Opprett et prosjekt i Google Cloud Console, aktiver Calendar API, og lag en
# OAuth Client ID (Web application) med nøyaktig denne redirect-URI-en registrert:
# http://localhost:4000/api/calendar-connections/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar-connections/google/callback
# Samme OAuth-klient som over kan brukes til Google Photos også – bare legg
# også denne redirect-URI-en til i "Authorized redirect URIs", og skru på
# "Google Photos Picker API" i Google Cloud-prosjektet.
GOOGLE_PHOTOS_REDIRECT_URI=http://localhost:4000/api/photos/google/callback

# ---- Traccar (GPS-klokke for Adelia) ----
TRACCAR_URL=http://localhost:8082
TRACCAR_USERNAME=
TRACCAR_PASSWORD=
# Traccar device-ID for klokken (finnes i Traccar-adminpanelet)
TRACCAR_DEVICE_ID=
# Hvor ofte backend poller Traccar, i millisekunder (standard 3 min)
TRACCAR_POLL_INTERVAL_MS=180000

# ---- Xplora-klokke (uoffisielt API, samme innlogging som Xplora-appen) ----
# Bruk enten telefonnummer (+ landkode) ELLER e-post, samme som i Xplora-appen.
XPLORA_COUNTRY_CODE=+47
XPLORA_PHONE=
XPLORA_EMAIL=
XPLORA_PASSWORD=
# Navnet på barnet (ward) klokken tilhører, for å velge riktig hvis kontoen har flere
XPLORA_WARD_NAME=Adelia
XPLORA_POLL_INTERVAL_MS=180000

# ---- Geofence "hjemme" (for varsel når Adelia kommer hjem) ----
GEOFENCE_HOME_LAT=60.51
GEOFENCE_HOME_LON=5.24
GEOFENCE_RADIUS_M=150

# ---- Vær (api.met.no Locationforecast 2.0) ----
# Standard: Frekhaug
WEATHER_LAT=60.51
WEATHER_LON=5.24
# MET krever en identifiserende User-Agent med kontaktinfo
WEATHER_USER_AGENT=FamilieHub/1.0 (kontakt: din-epost@example.com)
# Cache-tid i minutter (MET krever maks 1 kall per 30 min per lokasjon)
WEATHER_CACHE_MINUTES=30

# ---- Buss (Entur JourneyPlanner GraphQL API) ----
# Stoppested-ID, f.eks. NSR:StopPlace:xxxx – finn med https://stoppested.entur.org
ENTUR_STOP_ID=
ENTUR_CLIENT_NAME=familiehub-frekhaug

# ---- Strømpris (hvakosterstrommen.no, gratis API – trenger ingen nøkkel) ----
# Prisområde: NO1 (Øst), NO2 (Sør), NO3 (Midt), NO4 (Nord), NO5 (Vest/Bergen)
POWER_PRICE_AREA=NO5

# ---- Fotoramme ----
# Mappe med bilder som vises i fotoramme-modus (organiseres i undermapper per familie)
PHOTOS_DIR=../photos
# Antall minutter uten aktivitet før fotoramme-modus starter
PHOTO_MODE_IDLE_MINUTES=5
# Mappe for belønningsbilder (organiseres i undermapper per familie)
REWARDS_IMAGES_DIR=./data/reward-images

# ---- Kameraer (babycall + overvåking, RTSP via ffmpeg) ----
# Sti til ffmpeg-programmet. "ffmpeg" holder om det ligger i PATH.
# Selve kameraene (navn + RTSP-URL) legges til via ⚙️-innstillingssiden i appen.
FFMPEG_PATH=ffmpeg

# ---- Garmin Connect (uoffisiell tilgang, samme innlogging som Garmin Connect-appen) ----
GARMIN_USERNAME=
GARMIN_PASSWORD=

# ---- Ut og leke (lekestatus-deling) ----
# Timer før en aktiv "ute og leker"-status utløper automatisk
PLAY_STATUS_EXPIRY_HOURS=2
# URL til FamilieHub-relay (del 2) – delt tjeneste, samme for alle familier.
# Tom = kun lokal modus, ingen vennedeling. La denne stå som den er.
RELAY_URL=https://familiehub.onrender.com
# VIKTIG: Endre denne til DERES familienavn – vises hos vennefamilier når dere deler status.
# Gjelder kun "hovedfamilien" (den som satte opp installasjonen) – andre
# familier setter sitt eget navn ved signup i appen.
FAMILY_NAME=Vår familie

# ---- Morgenbrief (personlig opplest morgenrapport per familiemedlem) ----
# Claude API-nøkkel fra console.anthropic.com. Tom = modulen bruker en
# ferdiggenerert demobrief i stedet for AI-generert innhold.
ANTHROPIC_API_KEY=
# Nyhets-RSS-strømmer (kommaseparerte URL-er) brukt som standard når et
# familiemedlem ikke har valgt egne. Seedet med NRK toppsaker.
BRIEF_RSS_FEEDS=https://www.nrk.no/toppsaker.rss

# ---- Økonomimodul (personlig økonomi, CSV-import + valgfri banktilkobling) ----
# Krypteringsnøkkel for Claude-nøkkel/Enable Banking-PEM lagret i databasen.
# MÅ settes til en ekte 32-byte hex-nøkkel før dette hostes for andre familier.
# Generer med: openssl rand -hex 32
FINANCE_ENCRYPTION_KEY=
# Global bryter for Enable Banking-kontoaggregering (ekte banksynk). Må være
# "true" HER OG PÅ FAMILIEN (i oppsettsveiviseren) for at synk skal kjøre.
# Stå som "false" til dere har en ekte Enable Banking-avtale/app-id.
ENABLE_BANKING_ACTIVE=false
# Sandbox: https://api.sandbox.enablebanking.com – Produksjon: https://api.enablebanking.com
ENABLE_BANKING_BASE_URL=https://api.enablebanking.com

# ---- Middagsplanlegger (AI-ukemeny via Claude, bruker ANTHROPIC_API_KEY over) ----
# Valgfri gratis nøkkel fra unsplash.com/developers – gir ekte matbilder på
# AI-genererte middagsforslag. Tom = kortene viser bare emoji i stedet.
UNSPLASH_ACCESS_KEY=
