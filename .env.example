# ====== FamilieHub – miljøvariabler ======
# Kopier denne filen til ".env" og fyll inn dine egne verdier.
# ".env" skal ALDRI committes til git (den ligger i .gitignore).

# ---- Server ----
PORT=4000
NODE_ENV=development
# Origin(er) frontend kjører på (kommaseparert), brukes til CORS
CORS_ORIGIN=http://localhost:5173

# ---- Database ----
# Sti til SQLite-databasefilen (relativt til backend/)
DB_PATH=./data/familiehub.db

# ---- Google Calendar-integrasjon (forberedt, ikke påkrevd ennå) ----
# Opprett et prosjekt i Google Cloud Console og aktiver Calendar API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/google/callback

# ---- Traccar (GPS-klokke for Adelia) ----
TRACCAR_URL=http://localhost:8082
TRACCAR_USERNAME=
TRACCAR_PASSWORD=
# Traccar device-ID for klokken (finnes i Traccar-adminpanelet)
TRACCAR_DEVICE_ID=
# Hvor ofte backend poller Traccar, i millisekunder (standard 3 min)
TRACCAR_POLL_INTERVAL_MS=180000

# ---- Geofence "hjemme" (for varsel når Adelia kommer hjem) ----
GEOFENCE_HOME_LAT=60.51
GEOFENCE_HOME_LON=5.24
GEOFENCE_RADIUS_M=150

# ---- Vær (api.met.no Locationforecast 2.0) ----
# Standard: Frekhaug
WEATHER_LAT=60.51
WEATHER_LON=5.24
# MET krever en identifiserende User-Agent med kontaktinfo
WEATHER_USER_AGENT=FamilieHub/1.0 (kontakt: din-epost@example.com)
# Cache-tid i minutter (MET krever maks 1 kall per 30 min per lokasjon)
WEATHER_CACHE_MINUTES=30

# ---- Buss (Entur JourneyPlanner GraphQL API) ----
# Stoppested-ID, f.eks. NSR:StopPlace:xxxx – finn med https://stoppested.entur.org
ENTUR_STOP_ID=
ENTUR_CLIENT_NAME=familiehub-frekhaug

# ---- Strømpris (hvakosterstrommen.no, gratis API – trenger ingen nøkkel) ----
# Prisområde: NO1 (Øst), NO2 (Sør), NO3 (Midt), NO4 (Nord), NO5 (Vest/Bergen)
POWER_PRICE_AREA=NO5

# ---- Fotoramme ----
# Mappe med bilder som vises i fotoramme-modus
PHOTOS_DIR=../photos
# Antall minutter uten aktivitet før fotoramme-modus starter
PHOTO_MODE_IDLE_MINUTES=5

# ---- Kameraer (babycall + overvåking, RTSP via ffmpeg) ----
# Sti til ffmpeg-programmet. "ffmpeg" holder om det ligger i PATH.
FFMPEG_PATH=ffmpeg
# RTSP-URL for hvert kamera, f.eks. rtsp://bruker:passord@192.168.1.50:554/stream1
CAMERA_1_NAME=Babyrom
CAMERA_1_RTSP_URL=
CAMERA_2_NAME=Inngang
CAMERA_2_RTSP_URL=

# ---- Garmin Connect (uoffisiell tilgang, samme innlogging som Garmin Connect-appen) ----
GARMIN_USERNAME=
GARMIN_PASSWORD=

# ---- Ut og leke (lekestatus-deling) ----
# Timer før en aktiv "ute og leker"-status utløper automatisk
PLAY_STATUS_EXPIRY_HOURS=2
# URL til FamilieHub-relay (del 2) – delt tjeneste, samme for alle familier.
# Tom = kun lokal modus, ingen vennedeling. La denne stå som den er.
RELAY_URL=https://familiehub.onrender.com
# VIKTIG: Endre denne til DERES familienavn – vises hos vennefamilier når dere deler status.
FAMILY_NAME=Vår familie
# PIN-kode for foreldre-innstillinger (vennefamilier, steder, utløpstid)
PARENT_PIN=1234
